{
  "categories": [
    { "title": "## Features", "labels": ["feat"] },
    { "title": "## Fixes", "labels": ["fix"] },
    { "title": "## Refactoring", "labels": ["refactor"] },
    { "title": "## Documentation", "labels": ["docs"] },
    { "title": "## Tests", "labels": ["test"] },
    { "title": "## Chores", "labels": ["chore"] }
  ],
  "label_extractor": [
    {
      "pattern": "^(feat|fix|refactor|docs|test|chore)(\\(.+\\))?:",
      "target": "$1"
    }
  ],
  "template": "#{{CHANGELOG}}",
  "pr_template": "- #{{TITLE}} (##{{NUMBER}})",
  "empty_template": "- No changes",
  "max_tags_to_fetch": 200,
  "max_pull_requests": 500,
  "max_back_track_time_days": 365
}
