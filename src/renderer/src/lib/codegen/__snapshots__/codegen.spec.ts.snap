exports[`snapshots: language × body type > go · urlencoded 1`] = `
"package main

import (
	"fmt"
	"io"
	"net/http"
	"net/url"
	"strings"
)

func main() {
	form := url.Values{}
	form.Add("a", "1 2")
	form.Add("b", "x&y")
	req, err := http.NewRequest("POST", "https://api.example.com/users?page=2", strings.NewReader(form.Encode()))
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-Trace", "abc")
	req.Header.Set("Content-Type", "application/x-www-form-urlencoded")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()

	data, _ := io.ReadAll(resp.Body)
	fmt.Println(resp.Status, string(data))
}
"
`;

