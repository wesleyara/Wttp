exports[`snapshots: language × body type > go · binary 1`] = `
"package main

import (
	"fmt"
	"io"
	"net/http"
	"os"
)

func main() {
	file, err := os.Open("/tmp/data.bin")
	if err != nil {
		panic(err)
	}
	defer file.Close()
	req, err := http.NewRequest("POST", "https://api.example.com/users?page=2", file)
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-Trace", "abc")
	req.Header.Add("Content-Type", "application/octet-stream")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()

	data, _ := io.ReadAll(resp.Body)
	fmt.Println(resp.Status, string(data))
}
"
`;

exports[`snapshots: language × body type > go · json 1`] = `
"package main

import (
	"fmt"
	"io"
	"net/http"
	"strings"
)

func main() {
	body := strings.NewReader("{\\"name\\":\\"Ada\\",\\"tags\\":[\\"a\\",\\"b\\"]}")
	req, err := http.NewRequest("POST", "https://api.example.com/users?page=2", body)
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-Trace", "abc")
	req.Header.Add("Content-Type", "application/json")

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()

	data, _ := io.ReadAll(resp.Body)
	fmt.Println(resp.Status, string(data))
}
"
`;

exports[`snapshots: language × body type > go · multipart 1`] = `
"package main

import (
	"bytes"
	"fmt"
	"io"
	"mime/multipart"
	"net/http"
	"os"
)

func main() {
	var payload bytes.Buffer
	writer := multipart.NewWriter(&payload)
	writer.WriteField("title", "Hello")
	if file, err := os.Open("/tmp/me.png"); err == nil {
		part, _ := writer.CreateFormFile("avatar", "/tmp/me.png")
		io.Copy(part, file)
		file.Close()
	} else {
		panic(err)
	}
	writer.Close()
	req, err := http.NewRequest("POST", "https://api.example.com/users?page=2", &payload)
	if err != nil {
		panic(err)
	}
	req.Header.Add("X-Trace", "abc")
	req.Header.Set("Content-Type", writer.FormDataContentType())

	resp, err := http.DefaultClient.Do(req)
	if err != nil {
		panic(err)
	}
	defer resp.Body.Close()

	data, _ := io.ReadAll(resp.Body)
	fmt.Println(resp.Status, string(data))
}
"
`;

