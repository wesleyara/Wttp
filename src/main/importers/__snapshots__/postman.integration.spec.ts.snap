          "pathParams": [
            {
              "enabled": true,
              "name": "id",
              "value": "",
            },
          ],
          "query": undefined,
          "scripts": undefined,
          "url": "https://{{auth0_domain}}/api/v2/logs/:id",
        },
      ],
      "docs": "Logs",
      "kind": "folder",
      "name": "Logs",
      "scripts": undefined,
